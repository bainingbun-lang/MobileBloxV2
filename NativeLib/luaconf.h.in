// luaconf.h.in - Patched Luau configuration for Roblox integration
// This file replaces the upstream luaconf.h

// Prevent upstream luaconf.h from being used
#define LUAU_CONF_H

// =============================================================================
// ROBLOX LUAU FORWARDERS - Use opaque pointers since types not defined yet
// =============================================================================

#include <stddef.h>

// Opaque type definitions (actual types defined in lua.h which includes this)
typedef struct lua_State lua_State;
typedef struct Table Table;
typedef struct GCObject GCObject;
typedef struct TValue TValue;
typedef struct LuaNode LuaNode;
typedef int (*Pfunc)(lua_State*, void*);

// Forward declarations for Roblox Luau functions (using opaque pointers)
extern "C" void luau_execute(lua_State* L);
extern "C" void luaD_throw(lua_State* L, int errcode);
extern "C" int luaD_rawrunprotected(lua_State* L, Pfunc f, void* ud);
extern "C" size_t luaC_step(lua_State* L, bool assist);
extern "C" void luaC_barriertable(lua_State* L, Table* t, GCObject* v);
extern "C" void luaV_gettable(lua_State* L, const TValue* t, TValue* key, void* val);
extern "C" void luaV_settable(lua_State* L, const TValue* t, TValue* key, void* val);

// Global objects (rebased at runtime)
extern "C" TValue* luaO_nilobject_ptr();
extern "C" LuaNode* luaH_dummynode_ptr();

// =============================================================================
// MACRO OVERRIDES - Redirect to Roblox's implementation
// =============================================================================

// In luavmexecute.cpp, luaD_call is called - redirect to our forwarder
#define luaD_call(L, nResults) luau_execute(L)

// In ldo.cpp
#define luaD_throw(L, errcode) ::luaD_throw(L, errcode)
#define luaD_rawrunprotected(L, f, ud) ::luaD_rawrunprotected(L, f, ud)

// In lgc.cpp
#define luaC_step(L, assist) ::luaC_step(L, assist)
#define luaC_barriertable(L, t, v) ::luaC_barriertable(L, t, v)

// In lvmutils.cpp
#define luaV_gettable(L, t, key, val) ::luaV_gettable(L, t, key, val)
#define luaV_settable(L, t, key, val) ::luaV_settable(L, t, key, val)

// In lobject.h - nil object
#undef luaO_nilobject
#define luaO_nilobject luaO_nilobject_ptr()

// In ltable.cpp - dummy node
#undef dummynode
#define dummynode luaH_dummynode_ptr()

// =============================================================================
// DO NOT INCLUDE UPSTREAM LUACONF.H - This file REPLACES it
// =============================================================================

// =============================================================================
// ADDITIONAL MOBILEBLOX CONFIG
// =============================================================================

// MobileBlox exploit configuration
#define MOBILEBLOX_EXPLOIT_NAME "MobileBlox"
#define MOBILEBLOX_EXPLOIT_VERSION "2.0.0"
#define MOBILEBLOX_LUA_CHUNK "@MB"
#define ROBLOX_TARGET_VERSION "2.603.563"

// Enable Luau features
#define LUAU_ENABLE_ASSERT 1
#define LUAU_USER_MEMORY 1

// Android specific
#define LUA_USE_LINUX
#define LUA_USE_DLOPEN
#define LUA_USE_POSIX
#define LUA_USE_READLINE 0
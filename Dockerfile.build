# MobileBlox V2 - Docker Build Environment for ARM64
# Usage: docker build -t mobileblox-build -f Dockerfile.build .
#        docker run --rm -v $(pwd):/src mobileblox-build

FROM ubuntu:22.04 AS builder

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive
ENV ANDROID_NDK_VERSION=r26d
ENV ANDROID_NDK_HOME=/opt/android-ndk
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH=$ANDROID_NDK_HOME:$ANDROID_SDK_ROOT/cmdline-tools/latest/bin:$ANDROID_SDK_ROOT/platform-tools:$PATH

# Install dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-17-jdk-headless \
    wget unzip cmake ninja-build git python3 \
    build-essential pkg-config libssl-dev \
    ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Download and install Android NDK r26d
RUN wget -q https://dl.google.com/android/repository/android-ndk-${ANDROID_NDK_VERSION}-linux.zip -O /tmp/ndk.zip && \
    unzip -q /tmp/ndk.zip -d /opt && \
    mv /opt/android-ndk-${ANDROID_NDK_VERSION} $ANDROID_NDK_HOME && \
    rm /tmp/ndk.zip

# Download and install Android SDK Command Line Tools
RUN wget -q https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip -O /tmp/sdk.zip && \
    mkdir -p $ANDROID_SDK_ROOT/cmdline-tools && \
    unzip -q /tmp/sdk.zip -d $ANDROID_SDK_ROOT/cmdline-tools && \
    mv $ANDROID_SDK_ROOT/cmdline-tools/cmdline-tools $ANDROID_SDK_ROOT/cmdline-tools/latest && \
    rm /tmp/sdk.zip

# Accept licenses and install platforms/build-tools
RUN yes | $ANDROID_SDK_ROOT/cmdline-tools/latest/bin/sdkmanager --licenses && \
    $ANDROID_SDK_ROOT/cmdline-tools/latest/bin/sdkmanager \
    "platforms;android-34" \
    "build-tools;34.0.0" \
    "platform-tools" \
    "ndk;${ANDROID_NDK_VERSION}"

# Install vcpkg for OpenSSL/curl/ngtcp2 ARM64
RUN git clone --depth 1 https://github.com/microsoft/vcpkg.git /opt/vcpkg && \
    /opt/vcpkg/bootstrap-vcpkg.sh

# Set up vcpkg triplet for Android ARM64
RUN echo 'set(VCPKG_TARGET_TRIPLET "arm64-android")' >> /opt/vcpkg/triplets/arm64-android.cmake && \
    cat > /opt/vcpkg/triplets/arm64-android.cmake << 'EOF'
set(VCPKG_TARGET_ARCHITECTURE arm64)
set(VCPKG_CRT_LINKAGE dynamic)
set(VCPKG_LIBRARY_LINKAGE static)
set(VCPKG_ANDROID_NDK_PATH $ENV{ANDROID_NDK_HOME})
set(VCPKG_CMAKE_SYSTEM_NAME Android)
set(VCPKG_CMAKE_SYSTEM_VERSION 24)
set(VCPKG_CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_ANDROID_NDK $ENV{ANDROID_NDK_HOME})
set(CMAKE_ANDROID_ARCH_ABI arm64-v8a)
set(CMAKE_ANDROID_NDK_TOOLCHAIN_VERSION clang)
set(CMAKE_SYSTEM_NAME Android)
set(CMAKE_SYSTEM_VERSION 24)
set(CMAKE_ANDROID_STL_TYPE c++_shared)
EOF

# Build OpenSSL, curl, ngtcp2, nghttp2, nghttp3 for ARM64 via vcpkg
RUN /opt/vcpkg/vcpkg install --triplet arm64-android \
    openssl \
    curl \
    ngtcp2 \
    nghttp2 \
    nghttp3 \
    zlib

WORKDIR /src

# Copy source
COPY . .

# Build native library
RUN mkdir -p build/arm64 && cd build/arm64 && \
    cmake -G Ninja \
    -DCMAKE_TOOLCHAIN_FILE=$ANDROID_NDK_HOME/build/cmake/android.toolchain.cmake \
    -DCMAKE_PREFIX_PATH=/opt/vcpkg/installed/arm64-android \
    -DANDROID_ABI=arm64-v8a \
    -DANDROID_PLATFORM=android-24 \
    -DANDROID_STL=c++_shared \
    -DCMAKE_BUILD_TYPE=Release \
    -DOpenSSL_ROOT_DIR=/opt/vcpkg/installed/arm64-android \
    -DCURL_ROOT_DIR=/opt/vcpkg/installed/arm64-android \
    ../.. && \
    ninja -j$(nproc)

# Build APK
RUN chmod +x gradlew && \
    ./gradlew assembleRelease --no-daemon -Dorg.gradle.jvmargs="-Xmx4g"

# Output artifacts
RUN mkdir -p /artifacts && \
    cp app/build/outputs/apk/release/app-release.apk /artifacts/MobileBloxV2-arm64.apk && \
    cp build/arm64/libMobileBlox.so /artifacts/libMobileBlox-arm64.so

FROM scratch AS export
COPY --from=builder /artifacts /

# Usage: docker run --rm mobileblox-build tar -C / -cf - artifacts | tar -xf -
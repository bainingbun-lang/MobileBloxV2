<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/bubble_icon"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:background="@drawable/bubble_background"
        android:contentDescription="@string/floating_bubble"
        android:padding="14dp"
        android:src="@drawable/ic_terminal" />

    <TextView
        android:id="@+id/bubble_close"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:background="@drawable/bubble_close_background"
        android:contentDescription="@string/close_bubble"
        android:gravity="center"
        android:text="×"
        android:textColor="@color/text_white"
        android:textSize="14sp"
        android:textStyle="bold" />

</FrameLayout>

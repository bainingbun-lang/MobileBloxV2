rule CXX_COMPILER__Luau.2eAnalyze.2eCLI_scanned_Release
  depfile = $DEP_FILE
  deps = gcc
  command = ${LAUNCHER}${CODE_CHECK}/data/data/com.termux/files/usr/bin/clang++ $DEFINES $INCLUDES $FLAGS -MD -MT $out -MF $DEP_FILE @$DYNDEP_MODULE_MAP_FILE -o $out -c $in
  description = Building CXX object $out


#############################################
# Rule for compiling CXX files.

rule CXX_COMPILER__Luau.2eAnalyze.2eCLI_unscanned_Release
  depfile = $DEP_FILE
  deps = gcc
  command = ${LAUNCHER}${CODE_CHECK}/data/data/com.termux/files/usr/bin/clang++ $DEFINES $INCLUDES $FLAGS -MD -MT $out -MF $DEP_FILE -o $out -c $in
  description = Building CXX object $out


#############################################
# Rule for linking CXX executable.

rule CXX_EXECUTABLE_LINKER__Luau.2eAnalyze.2eCLI_Release
  depfile = $DEP_FILE
  deps = gcc
  command = $PRE_LINK && /data/data/com.termux/files/usr/bin/clang++ $FLAGS $LINK_FLAGS $in -o $TARGET_FILE $LINK_PATH $LINK_LIBRARIES && $POST_BUILD
  description = Linking CXX executable $TARGET_FILE
  restat = $RESTAT


#############################################
# Rule for generating CXX dependencies.

rule CXX_SCAN__Luau.2eAst.2eCLI_Release
  depfile = $DEP_FILE
  command = "/data/data/com.termux/files/usr/bin/clang-scan-deps" -format=p1689 -- /data/data/com.termux/files/usr/bin/clang++ $DEFINES $INCLUDES $FLAGS -x c++ -c -o $OBJ_FILE -resource-dir "/data/data/com.termux/files/usr/lib/clang/21" -MT $DYNDEP_INTERMEDIATE_FILE -MD -MF $DEP_FILE $in > $DYNDEP_INTERMEDIATE_FILE.tmp && mv $DYNDEP_INTERMEDIATE_FILE.tmp $DYNDEP_INTERMEDIATE_FILE
  description = Scanning $in for CXX dependencies



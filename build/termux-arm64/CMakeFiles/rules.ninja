rule CXX_DYNDEP__Luau.2eAst.2eCLI_Release
  command = /data/data/com.termux/files/usr/bin/cmake -E cmake_ninja_dyndep --tdi=_deps/luau-build/CMakeFiles/Luau.Ast.CLI.dir/CXXDependInfo.json --lang=CXX --modmapfmt=clang --dd=$out @$out.rsp
  description = Generating CXX dyndep file $out
  rspfile = $out.rsp
  rspfile_content = $in
  restat = 1


